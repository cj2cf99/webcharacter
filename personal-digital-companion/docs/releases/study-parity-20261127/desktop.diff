+  overflow-wrap:anywhere;cursor:pointer;transition:border-color .15s,background-color .15s,transform .15s}
+.study-option+.study-option{margin-top:7px}
+.study-option:hover{border-color:var(--fy-gold);transform:translateX(3px)}
+.study-option:has(input:checked){border-color:var(--fy-accent);background:var(--fy-soft)}
+.study-option input{flex:none;margin:0;accent-color:var(--fy-accent)}
+.study-option select{margin-left:auto;max-width:55%;flex-shrink:1}
+
+.study-card textarea.study-memo{min-height:64px;font-size:13px}
+.study-thread{display:grid;gap:8px;padding-top:10px;border-top:1px dashed var(--fy-line)}
+.study-thread>button{justify-self:start}
+.study-entry{display:grid;gap:5px;padding:9px 12px;border-left:3px solid var(--fy-gold);border-radius:4px 10px 10px 4px;
+  background:var(--fy-paper);animation:fy-rise .25s ease-out backwards}
+
+/* 复盘 */
+@property --p{syntax:'<number>';inherits:false;initial-value:0}
+.study-ring{display:grid;place-items:center;flex:none;width:76px;height:76px;border-radius:50%;
+  background:conic-gradient(var(--fy-accent) calc(var(--p)*1turn),var(--fy-soft) 0);animation:study-ring .9s ease-out}
+.study-ring span{display:grid;place-items:center;width:60px;height:60px;border-radius:50%;background:var(--fy-surface);
+  font-weight:700;font-variant-numeric:tabular-nums}
+@keyframes study-ring{from{--p:0}}
 .study-score,.study-clock{font-variant-numeric:tabular-nums}
-.study-score{font-size:20px;color:var(--fy-accent)}
+.study-score{font-size:22px;color:var(--fy-accent)}
+
 .study-note{color:var(--fy-muted);font-size:12px}
-.study-prompt{font-size:17px}
+.study-note[data-error=true]{color:var(--fy-accent)}
 .study-speak::before{content:'🔊 '}
 .study-speak[hidden]{display:none}
 .study-speak[data-playing=true]{border-color:var(--fy-accent);animation:study-speaking .8s ease-in-out infinite alternate}
 @keyframes study-speaking{to{background:var(--fy-soft);box-shadow:0 0 0 3px var(--fy-soft)}}
-.study-note[data-error=true]{color:var(--fy-accent)}
 .study-voice{max-width:45%}
-.study-card input[type=text]{box-sizing:border-box;width:100%;padding:5px 7px;border:1px solid var(--fy-line);border-radius:6px;background:var(--fy-surface);color:var(--fy-ink)}
-.study-card .fy-dictation-field[hidden]{display:none}
 .study-generating{display:flex;align-items:center;gap:9px;color:var(--fy-muted);font-size:12px}
 .study-generating[hidden]{display:none}
 .study-spinner{flex:none;width:18px;height:18px;border-radius:50%;border:3px solid var(--fy-soft);border-top-color:var(--fy-accent);animation:study-spin .8s linear infinite}
 @keyframes study-spin{to{transform:rotate(1turn)}}
