{
  "plan": {
    "type": "object",
    "properties": {
      "organize": {"type": "string", "maxLength": 360},
      "additions": {"type": "string", "maxLength": 360},
      "format": {"type": "string", "maxLength": 360}
    },
    "required": ["organize", "additions", "format"],
    "additionalProperties": false
  },
  "draft": {
    "type": "object",
    "properties": {
      "text": {"type": "string", "maxLength": 1500},
      "note": {"type": "string", "maxLength": 240}
    },
    "required": ["text", "note"],
    "additionalProperties": false
  },
  "review": {
    "type": "object",
    "properties": {
      "decision": {"enum": ["accept", "unchanged", "revise"]},
      "part": {"type": "string", "maxLength": 40},
      "reason": {"type": "string", "maxLength": 360}
    },
    "required": ["decision", "part", "reason"],
    "additionalProperties": false
  }
}
