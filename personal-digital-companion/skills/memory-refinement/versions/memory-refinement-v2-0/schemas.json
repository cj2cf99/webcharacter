{
  "diagnose": {
    "type": "object",
    "properties": {
      "needsRewrite": {"enum": ["yes", "no"]},
      "issues": {"type": "array", "items": {"type": "string", "maxLength": 24}, "maxItems": 5},
      "plan": {"type": "string", "maxLength": 200}
    },
    "required": ["needsRewrite", "issues", "plan"],
    "additionalProperties": false
  },
  "rewriteDiary": {
    "type": "object",
    "properties": {
      "body": {"type": "string", "maxLength": 5000},
      "summary": {"type": "string", "maxLength": 200},
      "tags": {"type": "array", "items": {"type": "string", "maxLength": 50}, "maxItems": 10},
      "threads": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "no": {"type": "integer"},
            "text": {"type": "string", "maxLength": 300},
            "resolved": {"type": "boolean"}
          },
          "required": ["text"],
          "additionalProperties": false
        }
      },
      "note": {"type": "string", "maxLength": 200}
    },
    "required": ["body", "summary", "tags", "threads", "note"],
    "additionalProperties": false
  },
  "rewriteNag": {
    "type": "object",
    "properties": {
      "beforeEvaluation": {"type": "string", "maxLength": 4000},
      "afterEvaluation": {"type": "string", "maxLength": 4000},
      "talk": {
        "type": "array",
        "minItems": 1,
        "maxItems": 24,
        "items": {
          "type": "object",
          "properties": {
            "who": {"enum": ["绯月", "你", "结束记录"]},
            "at": {"type": "string", "maxLength": 40},
            "text": {"type": "string", "maxLength": 4000}
          },
          "required": ["who", "at", "text"],
          "additionalProperties": false
        }
      },
      "note": {"type": "string", "maxLength": 200}
    },
    "required": ["afterEvaluation", "talk", "note"],
    "additionalProperties": false
  },
  "review": {
    "type": "object",
    "properties": {
      "decision": {"enum": ["accept", "revise"]},
      "reason": {"type": "string", "maxLength": 160}
    },
    "required": ["decision", "reason"],
    "additionalProperties": false
  }
}
