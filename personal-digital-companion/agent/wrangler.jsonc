{
  "name": "companion-agent-local",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "r2_buckets": [{"binding":"myMainStorage","bucket_name":"mystorage"}],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "companion-agent-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
